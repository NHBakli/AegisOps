#!/usr/bin/env bash
# Create a WireGuard key pair for one AegisOps VPN device, or show the QR code
# of its configuration. Private keys stay in ~/.config/aegisops/wireguard.
#
#   scripts/aegisops-wg-peer new <name>   generate the key, print the YAML entry
#   scripts/aegisops-wg-peer qr <name>    show <name>.conf as a QR code (phone)
set -euo pipefail

directory="${AEGISOPS_WG_DIR:-$HOME/.config/aegisops/wireguard}"
usage() { sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

[[ $# -eq 2 ]] || usage
action="$1"
name="$2"
[[ $name =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || {
  echo "Nom invalide : minuscules, chiffres et tirets (32 caractères maximum)." >&2
  exit 1
}

case "$action" in
  new)
    command -v wg >/dev/null || {
      echo "Installe d'abord les outils : sudo apt install wireguard-tools qrencode" >&2
      exit 1
    }
    mkdir -p "$directory/peers"
    chmod 700 "$directory" "$directory/peers"
    key="$directory/peers/$name.key"
    # wg only reads and writes files through pipes here: the AppArmor profile
    # shipped with recent Ubuntu releases revokes file descriptors outside
    # /etc/wireguard, which silently produces empty files.
    if [[ -s $key ]] && public_key="$(wg pubkey 2>/dev/null < <(cat "$key"))" \
      && [[ -n $public_key ]]; then
      echo "La clé $key existe déjà : elle est conservée." >&2
    else
      (umask 077 && wg genkey | cat > "$key")
      public_key="$(cat "$key" | wg pubkey)"
    fi
    if [[ ! $public_key =~ ^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$ ]]; then
      rm -f "$key"
      echo "Échec de la génération de la clé : aucune clé valide produite." >&2
      exit 1
    fi
    (umask 077 && printf '%s\n' "$public_key" > "$directory/peers/$name.pub")
    cat <<YAML
Ajoute cet appareil à wireguard_peers dans hardening-vars.yml
(choisis une adresse libre du réseau VPN, par exemple 10.66.66.2) :

  - name: $name
    address: 10.66.66.X
    public_key: "$public_key"
YAML
    ;;
  qr)
    command -v qrencode >/dev/null || {
      echo "Installe qrencode : sudo apt install qrencode" >&2
      exit 1
    }
    config="$directory/$name.conf"
    [[ -r $config ]] || {
      echo "$config absent : lance d'abord playbooks/vpn.yml." >&2
      exit 1
    }
    cat "$config" | qrencode -t ansiutf8
    echo "Scanne ce code dans l'application WireGuard, puis efface l'écran (clear)."
    ;;
  *)
    usage
    ;;
esac
