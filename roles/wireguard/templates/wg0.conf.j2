# Managed by AegisOps. The private key is loaded from {{ wireguard_private_key_path }}
# at start-up so that it never appears in this file or in Ansible.
[Interface]
Address = {{ wireguard_server_address }}/{{ wireguard_network.split('/')[1] }}
ListenPort = {{ wireguard_port }}
# 1280 avoids stalled pages on mobile and tunnelled networks with a small MTU.
MTU = 1280
PostUp = wg set %i private-key {{ wireguard_private_key_path }}
# Peers reach the server address only: no routing into K3s pods, services or
# 127.0.0.1 (route_localnet is enabled by kube-proxy). The raw table is not
# managed by UFW, kube-proxy or flannel, so this rule is evaluated first.
PostUp = sysctl -qw net.ipv4.conf.%i.forwarding=0
PostUp = iptables -t raw -I PREROUTING -i %i ! -d {{ wireguard_server_address }}/32 -j DROP
PreDown = iptables -t raw -D PREROUTING -i %i ! -d {{ wireguard_server_address }}/32 -j DROP
{% for peer in wireguard_peers %}

# {{ peer.name }}
[Peer]
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.address }}/32
{% endfor %}
