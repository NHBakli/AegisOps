# Managed by AegisOps. Every target is local; nothing is scraped remotely.
global:
  scrape_interval: {{ monitoring_scrape_interval }}
  evaluation_interval: {{ monitoring_scrape_interval }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["{{ monitoring_listen_address }}:{{ monitoring_ports.prometheus }}"]
  - job_name: node
    static_configs:
      - targets: ["{{ monitoring_listen_address }}:{{ monitoring_ports.node_exporter }}"]
  # Grafana enforces its domain; other Host headers get a redirect.
  - job_name: grafana
    static_configs:
      - targets: ["{{ monitoring_grafana_domain }}:{{ monitoring_ports.grafana }}"]
