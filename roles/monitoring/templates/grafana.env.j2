# Managed by AegisOps. Mode 0600: contains the Grafana administrator secret.
GF_SERVER_HTTP_ADDR={{ monitoring_grafana_address }}
GF_SERVER_HTTP_PORT={{ monitoring_ports.grafana }}
GF_SERVER_DOMAIN={{ monitoring_grafana_domain }}
GF_SERVER_ROOT_URL=http://{{ monitoring_grafana_domain }}:{{ monitoring_ports.grafana }}/
# Rejects other Host headers, blocking DNS rebinding through the SSH tunnel.
GF_SERVER_ENFORCE_DOMAIN=true
GF_SECURITY_ADMIN_USER={{ monitoring_grafana_admin_user }}
GF_SECURITY_ADMIN_PASSWORD={{ monitoring_grafana_admin_password }}
GF_SECURITY_DISABLE_GRAVATAR=true
GF_SECURITY_COOKIE_SAMESITE=strict
GF_SECURITY_CONTENT_SECURITY_POLICY=true
GF_USERS_ALLOW_SIGN_UP=false
GF_USERS_ALLOW_ORG_CREATE=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_AUTH_BASIC_ENABLED=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_SNAPSHOTS_EXTERNAL_ENABLED=false
GF_NEWS_NEWS_FEED_ENABLED=false
GF_PLUGINS_PREINSTALL_DISABLED=true
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH={{ monitoring_grafana_dashboard_directory }}/aegisops-overview.json
